# HomeHelp backend configuration template — copy to infra/.env and fill in real values.
# docker-compose reads infra/.env automatically; .env is gitignored, this template is committed.

# --- Postgres (all 9 per-service databases share these creds) ---
POSTGRES_USER=homehelp
POSTGRES_PASSWORD=change-me

# --- Service-to-service auth (x-internal-key) — use a long random string in production ---
INTERNAL_KEY=change-me-to-a-long-random-secret

# --- Payment finance-data encryption key — use a long random string in production ---
FINANCE_ENC_KEY=change-me-to-a-long-random-secret

# --- Admin seed identities (used only on first boot of an empty admin DB) ---
ADMIN_SEED_EMAIL=admin@homehelp.in
ADMIN_SEED_PASSWORD=change-me
OPS_SEED_EMAIL=ops@homehelp.in
OPS_SEED_PASSWORD=change-me
NEW_ADMIN_DEFAULT_PASSWORD=change-me

# --- Dev OTPs (fixed one-time codes for testing; replace with a real SMS gateway for prod) ---
DEV_OTP=4321
WORKER_DEV_OTP=1234

# --- Razorpay payment gateway (seeded into admin settings on boot) ---
# Enables real Razorpay checkout for all methods: UPI, cards, net banking, wallets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google Maps / Places (powers catalog address search; blank => OpenStreetMap Nominatim fallback) ---
GOOGLE_MAPS_KEY=
