# HomeHelp backend configuration template — copy to infra/.env and fill in real values.
# docker-compose reads infra/.env automatically; .env is gitignored, this template is committed.

# --- Postgres (all 9 per-service databases share these creds) ---
POSTGRES_USER=homehelp
POSTGRES_PASSWORD=change-me

# --- Service-to-service auth (x-internal-key) — use a long random string in production ---
INTERNAL_KEY=change-me-to-a-long-random-secret

# --- Payment finance-data encryption key — use a long random string in production ---
FINANCE_ENC_KEY=change-me-to-a-long-random-secret

# --- Admin seed identities (used only on first boot of an empty admin DB) ---
ADMIN_SEED_EMAIL=admin@homehelp.in
ADMIN_SEED_PASSWORD=change-me
OPS_SEED_EMAIL=ops@homehelp.in
OPS_SEED_PASSWORD=change-me
NEW_ADMIN_DEFAULT_PASSWORD=change-me

# --- KYC document storage (S3-compatible; MinIO locally, real S3 in production) ---
# Local dev needs nothing here — the defaults match the minio service in docker-compose.
# In production point S3_ENDPOINT at AWS (or leave unset for the default AWS endpoint) and set
# real credentials. Documents are private: they are only ever read via short-lived signed URLs.
S3_REGION=us-east-1
S3_ACCESS_KEY=homehelp
S3_SECRET_KEY=change-me-minio
S3_BUCKET=homehelp-kyc
# Host ports for the local MinIO (API + console). Defaults avoid 9000/9001, which another local
# MinIO often already holds. Bound to 127.0.0.1 only — document storage is not a LAN service.
S3_PORT=9010
S3_CONSOLE_PORT=9011
# What signed URLs must point at: a browser opens them, so it cannot be the internal "minio" host.
# In production set this to your real S3/CDN origin (or leave unset when using AWS directly).
S3_PUBLIC_ENDPOINT=http://localhost:9010

# --- Dev OTPs (fixed one-time codes for testing; replace with a real SMS gateway for prod) ---
# WORKER_DEV_OTP pins the worker login code to a known value AND returns it in the request-otp
# response, because no SMS provider is wired up yet — it is the only way a code can reach you.
# The code is still stored hashed, expired, rate-limited and compared exactly like a real one.
# LEAVE IT UNSET IN PRODUCTION: unset means a random code that is never disclosed. Setting it in
# a reachable environment lets anyone log in as any active worker.
DEV_OTP=4321
WORKER_DEV_OTP=1234

# --- Razorpay payment gateway (seeded into admin settings on boot) ---
# Enables real Razorpay checkout for all methods: UPI, cards, net banking, wallets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google Maps / Places (powers catalog address search; blank => OpenStreetMap Nominatim fallback) ---
GOOGLE_MAPS_KEY=
