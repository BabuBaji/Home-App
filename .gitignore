# Build output / binaries
*.apk
HomeHelp-debug.apk

# Gradle / Android build output, at ANY level. apps/worker/.gitignore already covers its own
# subtree, but that does nothing for a root-level .gradle/ cache — which is how build caches,
# lock files and local.properties end up committed.
.gradle/
build/
.cxx/
captures/
local.properties
*.iml

# Signing keys — must never be committed
*.jks
*.keystore

# Node
node_modules/

# Runtime data / local config (not source)
*.db
payment.config.json
.env.production
.env
infra/.env
*.tsbuildinfo

# IDE
.idea/

# Screenshots / mockups (not source)
/_*.png
/*_SLIDE.png
/*MOCKSCREEN*.png
/*MOCK_SCREEN*.png
/*mock_screen*.png
docs/admin-mockups/

# OS / editor
Thumbs.db
.DS_Store

# Office temp files
~$*

# Spec/mockup folders (binary, not source)
/ADMIN/
/CUSTOMER/
/WORKER/
docs/CUSTOMER/
docs/WORKER/
*.docx
